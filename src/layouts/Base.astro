---
export interface NavLink {
  name: string;
  url: string;
}

interface Props {
  title: string;
  siteTitle: string;
  copyrightYear: number;
  copyrightName?: string;
  copyrightUrl?: string;
  lang?: string;
  sections?: NavLink[];
  description?: string;
  showHeader?: boolean;
  hamburgerNav?: boolean;
}

const {
  title,
  siteTitle,
  copyrightYear,
  copyrightName = siteTitle,
  copyrightUrl,
  lang = "en",
  sections = [],
  description,
  showHeader = true,
  hamburgerNav = true,
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  {description && <meta property="og:title" content={title} />}
  {description && <meta property="og:description" content={description} />}
  <slot name="head" />
</head>
<body>
  {sections.length > 0 && (
    <nav class={
      (hamburgerNav ? "section-nav" : "section-nav no-hamburger") +
      (showHeader ? " has-header-nav" : "")
    }>
      <div class="container">
        <input type="checkbox" id="section-nav-toggle" class="section-nav-toggle" />
        <label for="section-nav-toggle" class="hamburger" aria-label="Menu">☰</label>
        <div class="section-nav-links">
          {sections.map((section) => (
            <a href={section.url}>{section.name}</a>
          ))}
        </div>
      </div>
    </nav>
  )}

  {showHeader && (
    <header>
      <div class="container header-row">
        <h1>{siteTitle}</h1>
        {sections.length > 0 && (
          <nav class="header-nav" aria-label="Menu">
            <input type="checkbox" id="header-nav-toggle" class="header-nav-toggle" />
            <label for="header-nav-toggle" class="hamburger" aria-label="Menu">☰</label>
            <div class="header-nav-links">
              {sections.map((section) => (
                <a href={section.url}>{section.name}</a>
              ))}
            </div>
          </nav>
        )}
      </div>
    </header>
  )}

  <main>
    <div class="container">
      <article>
        <slot />
      </article>
    </div>
  </main>

  <footer>
    <div class="container">
      <p>
        &copy; {copyrightYear === currentYear ? currentYear : `${copyrightYear}–${currentYear}`}{" "}
        {copyrightUrl ? <a href={copyrightUrl}>{copyrightName}</a> : copyrightName}
      </p>
    </div>
  </footer>
</body>
</html>
